# This repo is the engine, not the videos.
#
# Everything below is user data or derived from it: your projects, your
# recordings, your music library, your renders. The tracked tree is src/kit,
# src/theme, scripts/, the skill and config — the parts that are the same for
# everyone.

node_modules/
out/
.tooling/
*.log

# Video projects. A project is projects/<slug>/ holding beats.yaml, Video.tsx
# and whatever else it needs. They are yours — keep them locally, or in a
# separate private repo.
projects/

# Generated by 'npm run sync' from whatever projects and music are present, so
# they differ on every checkout and would conflict constantly if tracked. The
# pre-hooks on studio/render/typecheck regenerate them.
src/registry.generated.ts
src/music.generated.ts

# Voiceovers and gameplay footage.
public/videos/

# The music library. music.yaml is tracked as the manifest format and worked
# example; the audio is not ours to redistribute, and analysis JSON without its
# track is useless.
public/music/**
!public/music/
!public/music/music.yaml
